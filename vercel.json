{
  "version": 2,
  "functions": {
    "api/procedures.js": { "includeFiles": "navdata/cifp/**" }
  },
  "redirects": [
    {
      "source": "/api/auth/chartfox/callback",
      "destination": "/app/chartfox-callback.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "destination": "https://www.stratos-tracker.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/sigmets", "destination": "/api/weather?type=sigmets" },
    { "source": "/phone", "destination": "/app/index.html" },
    { "source": "/phone/", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/app/" }
      ]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/app/manifest-efb.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/app/manifest-phone.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
